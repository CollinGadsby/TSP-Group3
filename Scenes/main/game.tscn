[sub_resource type="GDScript" id="GDScript_ve7bo"]
script/source = "extends Node2D

@onready var hand_view = $PlayerHand
@onready var deck_stack = $DeckStack
@onready var game_manager = get_node(\"GameManager\")  # ← change this
@onready var debug_overlay = $DebugOverlay

func _ready():
	get_window().reset_size()
	if get_parent().name == \"Tutorial\":
		return
	debug_overlay.bind()
	
	var player_names: Array
	if SteamManager.lobby_id != 0:
		player_names = []
		for member in SteamManager.lobby_members:
			player_names.append(Steam.getFriendPersonaName(member))
		var my_steam_id = SteamManager.get_my_steam_id()
		game_manager.my_player_index = SteamManager.lobby_members.find(my_steam_id)
	else:
		player_names = [\"test1\", \"bot1\"]
		game_manager.my_player_index = 0
	
	game_manager.start_game(player_names)
	
	var player = game_manager.players[game_manager.my_player_index]
	hand_view.player_data = player
	hand_view.bind()
	hand_view.refresh()
	deck_stack.refresh()
	
	# Rewire buttons through network-aware request functions
	$UI/VerifyButton.pressed.disconnect(game_manager._on_verify_button_pressed)
	$UI/PassButton.pressed.disconnect(game_manager._on_pass_button_pressed)
	$UI/VerifyButton.pressed.connect(game_manager.request_go_out)
	$UI/PassButton.pressed.connect(game_manager.request_pass_turn)
"

[sub_resource type="GDScript" id="GDScript_dpgfu"]
script/source = "extends Node

var state: GlobalEnums.GameState
@onready var game_manager = get_node(\"../../GameManager\")
signal debug_data_changed

func _on_pressed() -> void:
	if state == GlobalEnums.GameState.WAITING:
		state = GlobalEnums.GameState.DRAWING
		emit_signal(\"debug_data_changed\")
		game_manager.next_turn()
"

