[sub_resource type="GDScript" id="GDScript_ve7bo"]
script/source = "extends Node2D

@onready var hand_view = $PlayerHand
@onready var deck_stack = $DeckStack
@onready var game_manager = get_node(\"GameManager\")
@onready var debug_overlay = $DebugOverlay

func _ready():
	get_window().reset_size()
	if get_parent().name == \"Tutorial\":
		return
	debug_overlay.bind()

func on_game_started():
	var player = game_manager.get_current_player()
	hand_view.player_data = player
	hand_view.bind()
	hand_view.refresh()
	deck_stack.refresh()
"

[sub_resource type="GDScript" id="GDScript_dpgfu"]
script/source = "extends Node

var state: GlobalEnums.GameState
@onready var game_manager = get_node(\"../../GameManager\")
signal debug_data_changed

func _on_pressed() -> void:
	if state == GlobalEnums.GameState.WAITING:
		state = GlobalEnums.GameState.DRAWING
		emit_signal(\"debug_data_changed\")
		game_manager.next_turn()
"

